<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Damage_Requires_Priority</fullName>
    <active>true</active>
    <description>Ensures Damage requires to case is high.</description>
    <errorConditionFormula>AND(
  ISPICKVAL(Issue_Category__c, &quot;Damage&quot;),
  ISBLANK(TEXT(Priority__c))
)</errorConditionFormula>
    <errorDisplayField>Priority__c</errorDisplayField>
    <errorMessage>Priority is mandatory for Damage cases.</errorMessage>
</ValidationRule>
